# Optional reviewer-only AI learning. Keep disabled on public builds.
MOLEARN_AI_ENABLED=false
# Set both secrets in backend environment only. Leave blank to disable AI.
MOLEARN_LLM_API_KEY=
MOLEARN_AI_ACCESS_CODE=

MOLEARN_LLM_BASE_URL=https://api.deepseek.com
MOLEARN_LLM_MODEL=deepseek-flash

# These limits are per running backend process. They reset on restart.
MOLEARN_AI_MAX_CALLS_PER_PROCESS=30
MOLEARN_AI_REQUESTS_PER_MINUTE=6
MOLEARN_AI_CONCURRENCY=2
