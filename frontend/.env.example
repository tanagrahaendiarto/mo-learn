# Copy to .env.local for local use. Set a deployment-specific HTTPS backend in production.
# Server-side only: Next.js proxy and server-rendered search and profiles.
BACKEND_API_URL=http://127.0.0.1:8000

# Public build-time flag. false = live backend; true = labeled local demo data.
NEXT_PUBLIC_DEMO_MODE=false

# Server-side only. Enable the reviewer UI and exact AI POST proxy routes.
# Backend AI settings and the reviewer access code are still required.
MOLEARN_AI_UI_ENABLED=false
