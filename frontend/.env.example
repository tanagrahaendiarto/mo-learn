# moLearn — variabel environment frontend
# Salin file ini menjadi `.env.local` dan sesuaikan bila perlu.
# Tidak ada secret di frontend.

# Server-side only: dibaca oleh Route Handler /api/backend/*.
# Tidak di-expose ke browser.
BACKEND_API_URL=http://localhost:8000

# Flag client-side. `false` = backend live, `true` = fixture lokal (mode demo).
NEXT_PUBLIC_DEMO_MODE=false
